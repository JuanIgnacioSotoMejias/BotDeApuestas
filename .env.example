# CONFIGURACIÓN DEL BOT DE TELEGRAM
TELEGRAM_BOT_TOKEN=TU_TOKEN_DE_TELEGRAM_AQUI
TELEGRAM_CHAT_ID=TU_CHAT_ID_DE_TELEGRAM_AQUI
# Whitelist de IDs de Administradores (separados por comas)
TELEGRAM_ADMIN_IDS=5438936165,OTRO_ID_ADMIN


# CONFIGURACIÓN DE INTELIGENCIA ARTIFICIAL (LLM)
# Proveedores soportados: manual, openrouter, ollama, gemini
LLM_PROVIDER=manual

# API Key de Gemini (Google AI Studio)
GEMINI_API_KEY=TU_GEMINI_API_KEY_AQUI

# Configuración de OpenRouter (Regístrate en https://openrouter.ai/ y crea una clave gratuita)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# Configuración de Ollama (Servidor Local de IA - https://ollama.com/)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# CONFIGURACIÓN DE API DEPORTIVA (OPCIONAL)
# Deja en blanco si deseas utilizar el fallback automático
SPORTS_API_KEY=
SPORTS_API_URL=https://worldcupjson.net

# API-Football Key (de API-Sports)
API_FOOTBALL_KEY=
API_FOOTBALL_URL=https://v3.football.api-sports.io

# Clave de The Odds API (Regístrate gratis en https://the-odds-api.com/ para obtener cuotas reales de Bet365/Bookmakers)
THE_ODDS_API_KEY=

